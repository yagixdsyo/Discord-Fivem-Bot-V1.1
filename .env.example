# =============================================================================
# Xqeria Dev V1.1 - discord.gg/bdfd
# Bu dosyayi `.env` olarak kopyalayin ve gercek degerleri girin.
# =============================================================================

# --- Genel ---
NODE_ENV=production
LOG_LEVEL=info
DEFAULT_PREFIX=.
DEFAULT_TIMEZONE=Europe/Istanbul

# --- Bot sahipleri (virgulle ayrilmis Discord ID'leri) ---
OWNER_IDS=
DEV_GUILD_ID=

# --- Bot tokenlari (en az biri dolu olmali) ---
BOT_TOKEN=
BOT_FIVEM_TOKEN=
BOT_PUBLIC_TOKEN=
BOT_GUARD_TOKEN=
BOT_TICKET_TOKEN=
BOT_YETKIKONTROL_TOKEN=

# Presence intenti (mesai "oyunda mi" kontrolu icin)
ENABLE_PRESENCE_INTENT=true

# --- MongoDB ---
MONGO_URI=mongodb://botuser:botpass@localhost:27017/?authSource=admin
MONGO_DB_NAME=fivem_bot

# --- Redis (opsiyonel) ---
REDIS_URL=redis://localhost:6379

# --- Saglik endpointi (/health) ---
HEALTH_PORT=3000

# --- Owner log kanali ---
OWNER_LOG_GUILD_ID=
OWNER_LOG_CHANNEL_ID=

# --- FiveM ---
FIVEM_CFX_CODE=
FIVEM_IP=
FIVEM_WH_PORT=3001

# --- Emojiler ---
# Deger bicimi: duz ID (1546118465876795462) veya <:isim:id> / <a:isim:id>
